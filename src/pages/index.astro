
---
import { getCollection } from "astro:content";
import Container from "../components/common/Container.astro";
import Button from "../components/common/Button.astro";
import Badge from "../components/common/Badge.astro";
import Card from "../components/common/Card.astro";
import SectionHeading from "../components/common/SectionHeading.astro";
import ProductCard from "../components/product/ProductCard.astro";

import MainLayout from "../layouts/MainLayout.astro";

const featuredProducts = (await getCollection("products"))
  .filter((product) => product.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 6);
---

<MainLayout
  title="BPVN - Bioprocess Vietnam"
  description="Advanced bioprocess technologies and solutions."
>
  <section class="section">
    <Container>

      <SectionHeading
        eyebrow="Bioprocess Vietnam"
        title="Building Better Bioprocess Solutions"
        description="Explore our portfolio of advanced bioprocess technologies, products and solutions."
      />

      <div class="demo-buttons">
        <Button>Contact Us</Button>

        <Button variant="secondary">
          Explore Solutions
        </Button>

        <Button variant="outline">
          View Products
        </Button>
      </div>

      <section class="featured-products" aria-labelledby="featured-products-title">
        <SectionHeading
          eyebrow="Our Products"
          title="Featured Products"
          description="Explore selected products from our bioprocess portfolio."
        />

        {featuredProducts.length > 0 ? (
          <div class="featured-products__grid">
            {featuredProducts.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        ) : (
          <p class="featured-products__empty">
            Featured products will be displayed here soon.
          </p>
        )}

        <div class="featured-products__action">
          <Button href="/products/" variant="outline">
            View All Products
          </Button>
        </div>
      </section>

    </Container>
  </section>
</MainLayout>

<style>
  .demo-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .featured-products {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: stretch;
  }

  .featured-products__empty {
    margin: var(--space-8) 0;
    padding: var(--space-8);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .featured-products__action {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  @media (max-width: 760px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .featured-products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
