---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import ProductFilters from "../../components/product/ProductFilters.astro";
import ProductGrid from "../../components/product/ProductGrid.astro";
import SectionHeading from "../../components/common/SectionHeading.astro";

const products = (await getCollection("products"))
  .sort(
    (a, b) =>
      a.data.sortOrder - b.data.sortOrder ||
      a.data.title.localeCompare(b.data.title),
  );

const brandNames: Record<string, string> = {
  biolink: "BioLink",
  lisure: "Lisure",
};

const brandSlugs = [
  ...new Set(products.map((product) => product.data.brand)),
].sort((a, b) => a.localeCompare(b));

const brands = brandSlugs.map((slug) => ({
  value: slug,
  label: brandNames[slug] ?? slug,
}));
---

<MainLayout
  title="Products | Bioprocess Vietnam"
  description="Explore bioprocess equipment and technologies from Bioprocess Vietnam. Filter products by category, subcategory and brand."
>
  <section class="products-hero">
    <div class="container">
      <SectionHeading
        eyebrow="BIOPROCESS VIETNAM"
        title="Our Products"
        description="Bioprocess equipment and technologies for biopharmaceutical research, process development and manufacturing."
        level="h1"
      />
    </div>
  </section>

  <div class="container products-main">
    <ProductFilters brands={brands} />

    <section class="products-results" aria-label="Product results">
      <div class="products-results__heading">
        <SectionHeading
          title="Product Catalogue"
          level="h2"
        />
        <p class="products-results__count" data-results-count>
          {products.length} products
        </p>
      </div>

      {products.length > 0 ? (
        <ProductGrid products={products} />
      ) : (
        <p class="products-results__empty">
          Product information will be available soon.
        </p>
      )}
    </section>
  </div>
</MainLayout>

<style>
    .products-hero {
      padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
      background: var(--color-primary);
      color: var(--color-white);
    }

    .products-hero :global(.section-heading) {
      margin-bottom: 0;
    }

    .products-hero :global(.section-heading__eyebrow) {
      color: #d9d1ff;
    }

    .products-hero :global(.section-heading__title) {
      color: var(--color-white);
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      line-height: var(--line-tight);
    }

    .products-hero :global(.section-heading__description) {
      max-width: 720px;
      margin-top: var(--space-2);
      color: #f0edff;
      font-size: var(--text-small);
      line-height: var(--line-body);
    }

    .products-main {
      padding-block: var(--space-8) var(--space-20);
    }

    .products-results {
      margin-top: var(--space-8);
      min-width: 0;
    }

    .products-results__heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-5);
    }

    .products-results__heading :global(.section-heading) {
      margin-bottom: 0;
    }

    .products-results__heading .products-results__count {
      flex: 0 0 auto;
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--text-small);
    }

    .products-results__empty {
      padding: var(--space-8);
      border: 1px dashed var(--color-border-strong);
      border-radius: var(--radius-lg);
      color: var(--color-text-secondary);
      text-align: center;
    }
</style>
