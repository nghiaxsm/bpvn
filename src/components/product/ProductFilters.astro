---
import { productCategories } from "../../data/product-categories";
import Button from "../common/Button.astro";

interface FilterOption {
  value: string;
  label: string;
}

interface Props {
  brands: FilterOption[];
}

const { brands } = Astro.props;
---

<section class="product-filters" aria-label="Product filters" data-product-filters>
  <div class="product-filters__search">
    <label class="product-filters__label" for="product-search">Search products</label>
    <input
      id="product-search"
      type="search"
      placeholder="Search products..."
      autocomplete="off"
      data-product-search
    />
  </div>

  <div class="product-filters__group" aria-label="Main categories">
    <h3 class="product-filters__heading">Main Category</h3>
    <div class="product-filters__options">
      <Button
        variant="filter"
        size="sm"
        class="product-filter-all"
        ariaPressed={true}
        dataFilterAll="parent"
      >
        All
      </Button>
      {productCategories.map((category) => (
        <Button
          variant="filter"
          size="sm"
          class="product-filter-toggle"
          ariaPressed={false}
          dataFilterToggle="parent"
          dataFilterValue={category.id}
        >
          {category.name}
        </Button>
      ))}
    </div>
  </div>

  <div class="product-filters__group" aria-label="Subcategories" data-subcategory-filter-group hidden>
    <h3 class="product-filters__heading">Subcategory</h3>
    {productCategories.map((category) => (
      <div class="filter-category-group" data-subcategory-group={category.id} hidden>
        <div class="product-filters__options">
          <Button
            variant="filter"
            size="sm"
            class="product-filter-all"
            ariaPressed={true}
            dataFilterAll="subcategory"
            dataParentId={category.id}
          >
            All
          </Button>
          {category.subcategories.map((subcategory) => (
            <Button
              variant="filter"
              size="sm"
              class="product-filter-toggle"
              ariaPressed={false}
              dataFilterToggle="subcategory"
              dataFilterValue={subcategory.id}
              dataParentId={category.id}
            >
              {subcategory.name}
            </Button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="product-filters__group" aria-label="Brands">
    <h3 class="product-filters__heading">Brands</h3>
    <div class="product-filters__options">
      <Button
        variant="filter"
        size="sm"
        class="product-filter-all"
        ariaPressed={true}
        dataFilterAll="brand"
      >
        All
      </Button>
      {brands.map((brand) => (
        <Button
          variant="filter"
          size="sm"
          class="product-filter-toggle"
          ariaPressed={false}
          dataFilterToggle="brand"
          dataFilterValue={brand.value}
        >
          {brand.label}
        </Button>
      ))}
    </div>
  </div>

  <div class="product-filters__footer">
    <span class="product-filters__active" data-active-filters aria-live="polite">All products</span>
    <Button variant="outline" size="sm" class="product-filters__clear" dataClearFilters={true}>
      Clear all
    </Button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-product-filters]");

  if (root) {
    const searchInput = root.querySelector<HTMLInputElement>("[data-product-search]");
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-product-card]"),
    );
    const count = document.querySelector<HTMLElement>("[data-results-count]");
    const activeFilters = root.querySelector<HTMLElement>("[data-active-filters]");
    const noResults = document.querySelector<HTMLElement>("[data-no-results]");
    const subcategoryContainer = root.querySelector<HTMLElement>("[data-subcategory-filter-group]");

    const getButtons = (selector: string) =>
      Array.from(root.querySelectorAll<HTMLButtonElement>(selector));

    const getSelectedButton = (type: string) =>
      getButtons(`[data-filter-toggle="${type}"]`).find(
        (button) => button.getAttribute("aria-pressed") === "true",
      );

    const getSelectedValue = (type: string) =>
      getSelectedButton(type)?.dataset.filterValue ?? "";

    const setPressed = (button: HTMLButtonElement, pressed: boolean) => {
      button.setAttribute("aria-pressed", String(pressed));
    };

    const clearLevel = (type: string, parentId?: string) => {
      getButtons(`[data-filter-toggle="${type}"]`)
        .filter((button) => !parentId || button.dataset.parentId === parentId)
        .forEach((button) => setPressed(button, false));

      getButtons(`[data-filter-all="${type}"]`)
        .filter((button) => !parentId || button.dataset.parentId === parentId)
        .forEach((button) => setPressed(button, true));
    };

    const updateSubcategoryVisibility = () => {
      const selectedParent = getSelectedValue("parent");

      if (subcategoryContainer) {
        subcategoryContainer.hidden = !selectedParent;
      }

      root.querySelectorAll<HTMLElement>("[data-subcategory-group]").forEach((group) => {
        const isActiveGroup = Boolean(selectedParent) &&
          group.dataset.subcategoryGroup === selectedParent;
        group.hidden = !isActiveGroup;
      });

      if (!selectedParent) {
        clearLevel("subcategory");
      }
    };

    const applyFilters = () => {
      const searchTerm = searchInput?.value.trim().toLocaleLowerCase() ?? "";
      const selectedParent = getSelectedValue("parent");
      const selectedSubcategory = getSelectedValue("subcategory");
      const selectedBrand = getSelectedValue("brand");

      // Build the parent -> subcategory mapping from rendered controls.
      // Frontmatter variables are not directly available inside a client-side script.
      const activeSubcategoryGroup = selectedParent
        ? root.querySelector<HTMLElement>(
            `[data-subcategory-group="${CSS.escape(selectedParent)}"]`,
          )
        : null;

      const parentSubcategoryIds = activeSubcategoryGroup
        ? Array.from(
            activeSubcategoryGroup.querySelectorAll<HTMLButtonElement>(
              '[data-filter-toggle="subcategory"]',
            ),
          ).map((button) => button.dataset.filterValue ?? "")
        : [];

      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCategories = (card.dataset.categories ?? "")
          .split("|")
          .map((value) => value.trim())
          .filter(Boolean);
        const cardBrand = card.dataset.brand ?? "";
        const searchableText = (card.dataset.search ?? "").toLocaleLowerCase();

        const matchesSearch = !searchTerm || searchableText.includes(searchTerm);
        const matchesParent =
          !selectedParent ||
          cardCategories.some((categoryId) => parentSubcategoryIds.includes(categoryId));
        const matchesSubcategory =
          !selectedSubcategory || cardCategories.includes(selectedSubcategory);
        const matchesBrand = !selectedBrand || selectedBrand === cardBrand;

        const isVisible =
          matchesSearch && matchesParent && matchesSubcategory && matchesBrand;

        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (count) count.textContent = `${visibleCount} products`;
      if (noResults) noResults.hidden = visibleCount !== 0;

      const activeCount = [
        selectedParent,
        selectedSubcategory,
        selectedBrand,
        searchTerm,
      ].filter(Boolean).length;

      if (activeFilters) {
        activeFilters.textContent = activeCount
          ? `${activeCount} filters selected`
          : "All products";
      }
    };

    // Event delegation ensures all filter buttons, including dynamically rendered
    // subcategory groups, use the same selection logic.
    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const toggleButton = target.closest<HTMLButtonElement>("[data-filter-toggle]");
      const allButton = target.closest<HTMLButtonElement>("[data-filter-all]");
      const clearButton = target.closest<HTMLButtonElement>("[data-clear-filters]");

      if (toggleButton && root.contains(toggleButton)) {
        const type = toggleButton.dataset.filterToggle ?? "";
        const wasSelected = toggleButton.getAttribute("aria-pressed") === "true";
        const parentId = toggleButton.dataset.parentId;

        // Only one option can be active within each filter level.
        clearLevel(type, type === "subcategory" ? parentId : undefined);

        if (!wasSelected) {
          setPressed(toggleButton, true);
          getButtons(`[data-filter-all="${type}"]`)
            .filter((button) =>
              type !== "subcategory" || button.dataset.parentId === parentId,
            )
            .forEach((button) => setPressed(button, false));
        }

        if (type === "parent") {
          clearLevel("subcategory");
          updateSubcategoryVisibility();
        }

        applyFilters();
        return;
      }

      if (allButton && root.contains(allButton)) {
        const type = allButton.dataset.filterAll ?? "";
        const parentId = allButton.dataset.parentId;

        clearLevel(type, type === "subcategory" ? parentId : undefined);

        if (type === "parent") {
          clearLevel("subcategory");
          updateSubcategoryVisibility();
        }

        applyFilters();
        return;
      }

      if (clearButton && root.contains(clearButton)) {
        if (searchInput) searchInput.value = "";
        clearLevel("parent");
        clearLevel("subcategory");
        clearLevel("brand");
        updateSubcategoryVisibility();
        applyFilters();
      }
    });

    searchInput?.addEventListener("input", applyFilters);

    // Restore category selections from navigation links in the Products dropdown.
    const params = new URLSearchParams(window.location.search);
    const categoryParam = params.get("category") ?? "";
    const subcategoryParam = params.get("subcategory") ?? "";

    const parentButton = getButtons('[data-filter-toggle="parent"]').find(
      (button) => button.dataset.filterValue === categoryParam,
    );

    if (parentButton) {
      setPressed(parentButton, true);
      getButtons('[data-filter-all="parent"]').forEach((button) => setPressed(button, false));

      const subcategoryButton = getButtons('[data-filter-toggle="subcategory"]').find(
        (button) =>
          button.dataset.filterValue === subcategoryParam &&
          button.dataset.parentId === categoryParam,
      );

      if (subcategoryButton) {
        setPressed(subcategoryButton, true);
        getButtons('[data-filter-all="subcategory"]')
          .filter((button) => button.dataset.parentId === categoryParam)
          .forEach((button) => setPressed(button, false));
      }
    }

    updateSubcategoryVisibility();
    applyFilters();
  }
</script>

<style>
  .product-filters {
    display: grid;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    background: var(--color-white);
  }

  .product-filters__search {
    display: grid;
    max-width: 360px;
    gap: 5px;
  }

  .product-filters__label,
  .product-filters__heading {
    display: block;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    letter-spacing: 0.025em;
  }

  .product-filters__search input {
    box-sizing: border-box;
    width: 100%;
    min-height: 36px;
    padding: 7px 10px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md, 8px);
    background: var(--color-white);
    color: var(--color-text);
    font: inherit;
    font-size: 13px;
  }

  .product-filters__group {
    display: grid;
    gap: 7px;
  }

  .product-filters__options {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .filter-category-group {
    display: block;
  }

  .product-filters__footer {
    display: flex;
    min-height: 30px;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }

  .product-filters__active {
    color: var(--color-text-muted);
    font-size: 11px;
  }

  .product-filters__clear {
    margin-left: auto;
  }

  .product-filters [hidden] {
    display: none !important;
  }

  @media (max-width: 640px) {
    .product-filters {
      gap: 11px;
      padding: 12px;
    }

    .product-filters__search {
      max-width: none;
    }
  }
</style>
