---
import { productCategories } from "../../data/product-categories";
import Button from "../common/Button.astro";

interface FilterOption {
  value: string;
  label: string;
}

interface Props {
  brands: FilterOption[];
}

const { brands } = Astro.props;
---

<section class="product-filters" aria-label="Product filters" data-product-filters>
  <div class="product-filters__top-row">
    <div class="product-filters__search">
      <label class="product-filters__label" for="product-search">Search</label>
      <input
        id="product-search"
        type="search"
        placeholder="Search products..."
        autocomplete="off"
        data-product-search
      />
    </div>

    <div class="product-filters__group product-filters__group--main" aria-label="Main categories">
      <h3 class="product-filters__heading">Categories</h3>
      <div class="product-filters__options">
        <Button
          variant="filter"
          size="sm"
          class="product-filter-all"
          ariaPressed={true}
          dataFilterAll="parent"
        >
          All
        </Button>
        {productCategories.map((category) => (
          <Button
            variant="filter"
            size="sm"
            class="product-filter-toggle"
            ariaPressed={false}
            dataFilterToggle="parent"
            dataFilterValue={category.id}
          >
            {category.name}
          </Button>
        ))}
      </div>
    </div>

    <div class="product-filters__group product-filters__group--brands" aria-label="Brands">
      <h3 class="product-filters__heading">Brand</h3>
      <div class="product-filters__options">
        <Button
          variant="filter"
          size="sm"
          class="product-filter-all"
          ariaPressed={true}
          dataFilterAll="brand"
        >
          All
        </Button>
        {brands.map((brand) => (
          <Button
            variant="filter"
            size="sm"
            class="product-filter-toggle"
            ariaPressed={false}
            dataFilterToggle="brand"
            dataFilterValue={brand.value}
          >
            {brand.label}
          </Button>
        ))}
      </div>
    </div>
  </div>

  <div class="product-filters__subcategory-row" data-subcategory-filter-group hidden>
    <div class="product-filters__group product-filters__group--subcategory" aria-label="Subcategories">
      <h3 class="product-filters__heading">Sub-category</h3>
      {productCategories.map((category) => (
        <div class="filter-category-group" data-subcategory-group={category.id} hidden>
          <div class="product-filters__options">
            <Button
              variant="filter"
              size="sm"
              class="product-filter-all"
              ariaPressed={true}
              dataFilterAll="subcategory"
              dataParentId={category.id}
            >
              All
            </Button>
            {category.subcategories.map((subcategory) => (
              <Button
                variant="filter"
                size="sm"
                class="product-filter-toggle"
                ariaPressed={false}
                dataFilterToggle="subcategory"
                dataFilterValue={subcategory.id}
                dataParentId={category.id}
              >
                {subcategory.name}
              </Button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="product-filters__footer">
    <span class="product-filters__active" data-active-filters aria-live="polite">All products</span>
    <Button variant="outline" size="sm" class="product-filters__clear" dataClearFilters={true}>
      Clear all
    </Button>
  </div>
</section>

<script>
  const root = document.querySelector("[data-product-filters]");

  if (root) {
    const searchInput = root.querySelector("[data-product-search]");
    const cards = Array.from(document.querySelectorAll("[data-product-card]"));
    const count = document.querySelector("[data-results-count]");
    const activeFilters = root.querySelector("[data-active-filters]");
    const noResults = document.querySelector("[data-no-results]");
    const subcategoryContainer = root.querySelector("[data-subcategory-filter-group]");
    const pagination = document.querySelector("[data-product-pagination]");
    const pageNumbers = pagination?.querySelector("[data-page-numbers]");
    const previousButton = pagination?.querySelector("[data-page-previous]");
    const nextButton = pagination?.querySelector("[data-page-next]");
    const pageSize = 12;
    let currentPage = 1;
    let matchedCards = [];

    const getButtons = (selector) =>
      Array.from(root.querySelectorAll(selector));

    const getSelectedButton = (type) =>
      getButtons(`[data-filter-toggle="${type}"]`).find(
        (button) => button.getAttribute("aria-pressed") === "true",
      );

    const getSelectedValue = (type) =>
      getSelectedButton(type)?.dataset.filterValue ?? "";

    const setPressed = (button, pressed) => {
      button.setAttribute("aria-pressed", String(pressed));
    };

    const clearLevel = (type, parentId) => {
      getButtons(`[data-filter-toggle="${type}"]`)
        .filter((button) => !parentId || button.dataset.parentId === parentId)
        .forEach((button) => setPressed(button, false));

      getButtons(`[data-filter-all="${type}"]`)
        .filter((button) => !parentId || button.dataset.parentId === parentId)
        .forEach((button) => setPressed(button, true));
    };

    const updateSubcategoryVisibility = () => {
      const selectedParent = getSelectedValue("parent");

      if (subcategoryContainer) {
        subcategoryContainer.hidden = !selectedParent;
      }

      root.querySelectorAll("[data-subcategory-group]").forEach((group) => {
        group.hidden = !selectedParent ||
          group.dataset.subcategoryGroup !== selectedParent;
      });

      if (!selectedParent) clearLevel("subcategory");
    };

    const updateUrl = (method = "pushState") => {
      const params = new URLSearchParams(window.location.search);
      ["category", "subcategory", "brand", "q", "page"].forEach((key) => params.delete(key));

      const category = getSelectedValue("parent");
      const subcategory = getSelectedValue("subcategory");
      const brand = getSelectedValue("brand");
      const query = searchInput?.value.trim() ?? "";

      if (category) params.set("category", category);
      if (subcategory) params.set("subcategory", subcategory);
      if (brand) params.set("brand", brand);
      if (query) params.set("q", query);
      if (currentPage > 1) params.set("page", String(currentPage));

      const queryString = params.toString();
      const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ""}${window.location.hash}`;
      window.history[method]({}, "", nextUrl);
    };

    const createPageButton = (page, isCurrent = false) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "product-pagination__button";
      button.textContent = String(page);
      button.dataset.page = String(page);

      if (isCurrent) {
        button.setAttribute("aria-current", "page");
        button.setAttribute("aria-label", `Page ${page}, current page`);
      } else {
        button.setAttribute("aria-label", `Go to page ${page}`);
      }
      return button;
    };

    const renderPagination = (pageCount) => {
      if (!pagination || !pageNumbers || !previousButton || !nextButton) return;

      pagination.hidden = pageCount <= 1;
      pageNumbers.replaceChildren();

      if (pageCount <= 1) return;

      previousButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= pageCount;

      const visiblePages = new Set([1, pageCount]);
      for (
        let page = Math.max(1, currentPage - 2);
        page <= Math.min(pageCount, currentPage + 2);
        page += 1
      ) {
        visiblePages.add(page);
      }

      const sortedPages = Array.from(visiblePages).sort((a, b) => a - b);
      let previousPage = 0;

      sortedPages.forEach((page) => {
        if (previousPage && page - previousPage > 1) {
          const ellipsis = document.createElement("span");
          ellipsis.className = "product-pagination__ellipsis";
          ellipsis.textContent = "…";
          ellipsis.setAttribute("aria-hidden", "true");
          pageNumbers.append(ellipsis);
        }

        pageNumbers.append(createPageButton(page, page === currentPage));
        previousPage = page;
      });
    };

    const renderCurrentPage = () => {
      const pageCount = Math.max(1, Math.ceil(matchedCards.length / pageSize));
      currentPage = Math.min(Math.max(1, currentPage), pageCount);

      const start = (currentPage - 1) * pageSize;
      const end = start + pageSize;

      cards.forEach((card) => {
        card.hidden = true;
      });

      matchedCards.slice(start, end).forEach((card) => {
        card.hidden = false;
      });

      renderPagination(pageCount);
    };

    const applyFilters = ({ resetPage = false, updateHistory = null } = {}) => {
      const searchTerm = searchInput?.value.trim().toLocaleLowerCase() ?? "";
      const selectedParent = getSelectedValue("parent");
      const selectedSubcategory = getSelectedValue("subcategory");
      const selectedBrand = getSelectedValue("brand");

      const activeSubcategoryGroup = selectedParent
        ? root.querySelector(`[data-subcategory-group="${CSS.escape(selectedParent)}"]`)
        : null;

      const parentSubcategoryIds = activeSubcategoryGroup
        ? Array.from(activeSubcategoryGroup.querySelectorAll('[data-filter-toggle="subcategory"]'))
            .map((button) => button.dataset.filterValue ?? "")
        : [];

      matchedCards = cards.filter((card) => {
        const cardCategories = (card.dataset.categories ?? "")
          .split("|")
          .map((value) => value.trim())
          .filter(Boolean);
        const cardBrand = card.dataset.brand ?? "";
        const searchableText = (card.dataset.search ?? "").toLocaleLowerCase();

        const matchesSearch = !searchTerm || searchableText.includes(searchTerm);
        const matchesParent = !selectedParent ||
          cardCategories.some((categoryId) => parentSubcategoryIds.includes(categoryId));
        const matchesSubcategory = !selectedSubcategory ||
          cardCategories.includes(selectedSubcategory);
        const matchesBrand = !selectedBrand || selectedBrand === cardBrand;

        return matchesSearch && matchesParent && matchesSubcategory && matchesBrand;
      });

      if (resetPage) currentPage = 1;

      if (count) count.textContent = `${matchedCards.length} products`;
      if (noResults) noResults.hidden = matchedCards.length !== 0;

      const activeCount = [
        selectedParent,
        selectedSubcategory,
        selectedBrand,
        searchTerm,
      ].filter(Boolean).length;

      if (activeFilters) {
        activeFilters.textContent = activeCount
          ? `${activeCount} filters selected`
          : "All products";
      }

      renderCurrentPage();
      if (updateHistory) updateUrl(updateHistory);
    };

    const restoreFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const categoryParam = params.get("category") ?? "";
      const subcategoryParam = params.get("subcategory") ?? "";
      const brandParam = params.get("brand") ?? "";

      clearLevel("parent");
      clearLevel("subcategory");
      clearLevel("brand");

      if (searchInput) searchInput.value = params.get("q") ?? "";

      const parentButton = getButtons('[data-filter-toggle="parent"]')
        .find((button) => button.dataset.filterValue === categoryParam);

      if (parentButton) {
        setPressed(parentButton, true);
        getButtons('[data-filter-all="parent"]').forEach((button) => setPressed(button, false));
      }

      updateSubcategoryVisibility();

      const subcategoryButton = categoryParam
        ? getButtons('[data-filter-toggle="subcategory"]').find(
            (button) =>
              button.dataset.filterValue === subcategoryParam &&
              button.dataset.parentId === categoryParam,
          )
        : null;

      if (subcategoryButton) {
        setPressed(subcategoryButton, true);
        getButtons('[data-filter-all="subcategory"]')
          .filter((button) => button.dataset.parentId === categoryParam)
          .forEach((button) => setPressed(button, false));
      }

      const brandButton = getButtons('[data-filter-toggle="brand"]')
        .find((button) => button.dataset.filterValue === brandParam);

      if (brandButton) {
        setPressed(brandButton, true);
        getButtons('[data-filter-all="brand"]').forEach((button) => setPressed(button, false));
      }

      const requestedPage = Number.parseInt(params.get("page") ?? "1", 10);
      currentPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;
    };

    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const toggleButton = target.closest("[data-filter-toggle]");
      const allButton = target.closest("[data-filter-all]");
      const clearButton = target.closest("[data-clear-filters]");

      if (toggleButton && root.contains(toggleButton)) {
        const type = toggleButton.dataset.filterToggle ?? "";
        const wasSelected = toggleButton.getAttribute("aria-pressed") === "true";
        const parentId = toggleButton.dataset.parentId;

        clearLevel(type, type === "subcategory" ? parentId : undefined);

        if (!wasSelected) {
          setPressed(toggleButton, true);
          getButtons(`[data-filter-all="${type}"]`)
            .filter((button) => type !== "subcategory" || button.dataset.parentId === parentId)
            .forEach((button) => setPressed(button, false));
        }

        if (type === "parent") {
          clearLevel("subcategory");
          updateSubcategoryVisibility();
        }

        applyFilters({ resetPage: true, updateHistory: "pushState" });
        return;
      }

      if (allButton && root.contains(allButton)) {
        const type = allButton.dataset.filterAll ?? "";
        const parentId = allButton.dataset.parentId;

        clearLevel(type, type === "subcategory" ? parentId : undefined);

        if (type === "parent") {
          clearLevel("subcategory");
          updateSubcategoryVisibility();
        }

        applyFilters({ resetPage: true, updateHistory: "pushState" });
        return;
      }

      if (clearButton && root.contains(clearButton)) {
        if (searchInput) searchInput.value = "";
        clearLevel("parent");
        clearLevel("subcategory");
        clearLevel("brand");
        updateSubcategoryVisibility();
        applyFilters({ resetPage: true, updateHistory: "pushState" });
      }
    });

    searchInput?.addEventListener("input", () => {
      applyFilters({ resetPage: true, updateHistory: "replaceState" });
    });

    pagination?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const pageButton = target.closest("[data-page]");
      if (pageButton) {
        currentPage = Number.parseInt(pageButton.dataset.page ?? "1", 10);
      } else if (target.closest("[data-page-previous]")) {
        currentPage -= 1;
      } else if (target.closest("[data-page-next]")) {
        currentPage += 1;
      } else {
        return;
      }

      applyFilters({ updateHistory: "pushState" });
      document.querySelector("[data-product-grid]")?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });

    window.addEventListener("popstate", () => {
      restoreFromUrl();
      updateSubcategoryVisibility();
      applyFilters();
    });

    restoreFromUrl();
    updateSubcategoryVisibility();
    applyFilters();
  }
</script>

<style>
  .product-filters {
    display: grid;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    background: var(--color-white);
  }

  .product-filters__top-row {
    display: grid;
    grid-template-columns: minmax(190px, 0.85fr) minmax(360px, 2fr) minmax(170px, 0.9fr);
    align-items: start;
    gap: 12px;
  }

  .product-filters__search,
  .product-filters__group {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 5px;
  }

  .product-filters__label,
  .product-filters__heading {
    display: block;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  .product-filters__search input {
    box-sizing: border-box;
    width: 100%;
    min-height: 30px;
    padding: 5px 9px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md, 8px);
    background: var(--color-white);
    color: var(--color-text);
    font: inherit;
    font-size: 12px;
  }

  .product-filters__options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
  }

  .product-filters__subcategory-row {
    display: grid;
    padding-top: 7px;
    border-top: 1px solid var(--color-border);
  }

  .product-filters__group--subcategory {
    gap: 5px;
  }

  .filter-category-group {
    display: block;
  }

  .product-filters__footer {
    display: flex;
    min-height: 24px;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 5px;
    border-top: 1px solid var(--color-border);
  }

  .product-filters__active {
    color: var(--color-text-muted);
    font-size: 10px;
  }

  .product-filters__clear {
    margin-left: auto;
  }

  .product-filters [hidden] {
    display: none !important;
  }

  @media (max-width: 980px) {
    .product-filters__top-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .product-filters__search {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .product-filters {
      gap: 9px;
      padding: 10px;
    }

    .product-filters__top-row {
      grid-template-columns: 1fr;
      gap: 9px;
    }

    .product-filters__search {
      grid-column: auto;
    }
  }
</style>
