---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: CollectionEntry<"products">[];
}

const { products } = Astro.props;
---

<div class="product-grid" data-product-grid>
  {products.map((product) => <ProductCard product={product} />)}
</div>

<p class="product-grid__empty" data-no-results hidden>
  No products match your filters. Try changing or clearing your filters.
</p>

<nav class="product-pagination" aria-label="Product pages" data-product-pagination hidden>
  <button class="product-pagination__button" type="button" data-page-previous aria-label="Previous page">
    Previous
  </button>
  <div class="product-pagination__pages" data-page-numbers></div>
  <button class="product-pagination__button" type="button" data-page-next aria-label="Next page">
    Next
  </button>
</nav>

<style>
  @layer components {
    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
      align-items: stretch;
    }

    .product-grid__empty {
      margin: var(--space-8) 0;
      padding: var(--space-8);
      border: 1px dashed var(--color-border-strong);
      border-radius: var(--radius-lg);
      color: var(--color-text-secondary);
      text-align: center;
    }

    .product-pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: var(--space-8);
    }

    .product-pagination__pages {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
    }

    .product-pagination__button {
      display: inline-flex;
      min-width: 34px;
      min-height: 34px;
      align-items: center;
      justify-content: center;
      padding: 6px 11px;
      border: 1px solid var(--color-border-strong);
      border-radius: 9999px;
      background: var(--color-white);
      color: var(--color-text);
      font: inherit;
      font-size: 12px;
      cursor: pointer;
      transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
    }

    .product-pagination__button:hover:not(:disabled) {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    .product-pagination__button[aria-current="page"] {
      border-color: var(--color-primary);
      background: var(--color-primary);
      color: var(--color-white);
    }

    .product-pagination__button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .product-pagination__ellipsis {
      padding-inline: 3px;
      color: var(--color-text-muted);
      font-size: 12px;
    }

    .product-pagination [hidden] {
      display: none !important;
    }

    @media (max-width: 1100px) {
      .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 760px) {
      .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
      }
    }

    @media (max-width: 480px) {
      .product-grid {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
