---
import type { CollectionEntry } from "astro:content";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const { title, model, brand, categories, image } = product.data;

const brandNames: Record<string, string> = {
  biolink: "BioLink",
  lisure: "Lisure",
};

const brandLabel = brandNames[brand] ?? brand;
const productUrl = `/products/${product.id}/`;
---

<article
  class="product-card"
  data-product-card
  data-brand={brand}
  data-categories={categories.join("|")}
  data-search={`${title} ${model} ${brandLabel}`.toLowerCase()}
>
  <a class="product-card__link" href={productUrl} aria-label={`View ${title} – ${model}`}>
    <div class="product-card__media">
      {image ? (
        <img
          src={image}
          alt={title}
          loading="lazy"
          decoding="async"
          width="640"
          height="420"
        />
      ) : (
        <div class="product-card__placeholder" aria-label="Product image unavailable">
          <span>{brandLabel}</span>
        </div>
      )}
    </div>

    <div class="product-card__body">
      <p class="product-card__brand">{brandLabel}</p>
      <h2 class="product-card__title">{title}</h2>
      <p class="product-card__model">{model}</p>
    </div>
  </a>
</article>

<style>
  .product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal),
      border-color var(--transition-normal);
  }

  .product-card__link {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .product-card__media {
    display: grid;
    box-sizing: border-box;
    aspect-ratio: 16 / 10;
    place-items: center;
    overflow: hidden;
    padding: var(--space-4);
    background: var(--color-background-alt);
  }

  .product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    object-position: center;
  }

  .product-card__placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .product-card__brand {
    margin: 0;
    color: var(--color-secondary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
  }

  .product-card__title {
    margin: 0;
    color: var(--color-text);
    font-size: 20px;
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .product-card__model {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-body);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover {
      transform: translateY(-3px);
      border-color: var(--color-primary-light);
      box-shadow: var(--shadow-md);
    }
  }

  .product-card__link:focus-visible {
    outline: 3px solid var(--color-primary-light);
    outline-offset: -3px;
  }
</style>
