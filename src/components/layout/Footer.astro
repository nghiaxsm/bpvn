---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__main">
      <div class="footer__brand">
        <a
          href="/"
          class="footer__logo"
          aria-label="Bioprocess Vietnam - Home"
        >
          <img
            src="/logos/logo-reversed.svg"
            alt="Bioprocess Vietnam"
            width="210"
            height="70"
            loading="lazy"
          />
        </a>

        <p class="footer__description">
          Bioprocess Vietnam connects advanced bioprocess
          technologies, products and solutions with the
          needs of the biotechnology industry.
        </p>
      </div>

      <div class="footer__column">
        <h2 class="footer__heading">Explore</h2>
        <ul class="footer__links">
          <li><a href="/products">Products</a></li>
          <li><a href="/brands">Brands</a></li>
          <li><a href="/solutions">Solutions</a></li>
          <li><a href="/news">News &amp; Insights</a></li>
        </ul>
      </div>

      <div class="footer__column">
        <h2 class="footer__heading">Company</h2>
        <ul class="footer__links">
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>

      <div class="footer__column footer__contact">
        <h2 class="footer__heading">Get in Touch</h2>
        <p>
          Have a question about our products or solutions?
          Get in touch with our team.
        </p>
        <a href="/contact" class="footer__contact-link">
          Contact our team
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        © {currentYear} Bioprocess Vietnam. All rights reserved.
      </p>
      <a href="/" class="footer__back-home">
        Back to Home
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  /*
   * Footer uses explicit monochrome palette values.
   * These rules are intentionally unlayered so they take
   * precedence over generic global link and paragraph styles.
   */

  .site-footer {
    color: #ffffff;
    background: #120052;
  }

  .site-footer .footer__main {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: var(--space-10);
    padding-block: var(--space-16);
  }

  .site-footer .footer__brand {
    max-width: 360px;
  }

  .site-footer .footer__logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: var(--space-5);
  }

  .site-footer .footer__logo img {
    display: block;
    width: 220px;
    max-width: 100%;
    height: auto;
    aspect-ratio: 3 / 1;
    object-fit: contain;
  }

  .site-footer .footer__description,
  .site-footer .footer__contact p {
    color: #e9e4f8;
    font-size: var(--text-small);
    line-height: var(--line-body);
  }

  .site-footer .footer__description {
    margin-bottom: var(--space-5);
  }

  .site-footer .footer__column {
    min-width: 0;
  }

  .site-footer .footer__heading {
    margin: 0 0 var(--space-5);
    color: #ffffff;
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
  }

  .site-footer .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer .footer__links a,
  .site-footer .footer__back-home {
    color: #e9e4f8;
    font-size: var(--text-small);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-footer .footer__links a:hover,
  .site-footer .footer__back-home:hover {
    color: #ffffff;
  }

  .site-footer .footer__contact p {
    margin: 0 0 var(--space-4);
  }

  .site-footer .footer__contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: #d3c9f0;
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-footer .footer__contact-link:hover {
    color: #ffffff;
  }

  .site-footer .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    padding-block: var(--space-4);
    border-top: 1px solid rgb(255 255 255 / 28%);
  }

  .site-footer .footer__copyright {
    margin: 0;
    color: #d3c9f0;
    font-size: var(--text-small);
  }

  .site-footer .footer__back-home {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 1024px) {
    .site-footer .footer__main {
      grid-template-columns: 1.5fr 1fr 1fr;
      row-gap: var(--space-10);
    }

    .site-footer .footer__contact {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 640px) {
    .site-footer .footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-5);
      padding-block: var(--space-12);
    }

    .site-footer .footer__brand {
      grid-column: 1 / -1;
      max-width: 100%;
    }

    .site-footer .footer__contact {
      grid-column: auto;
    }

    .site-footer .footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-3);
    }
  }

  @media (max-width: 380px) {
    .site-footer .footer__main {
      grid-template-columns: 1fr;
    }

    .site-footer .footer__brand,
    .site-footer .footer__contact {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer .footer__links a,
    .site-footer .footer__contact-link,
    .site-footer .footer__back-home {
      transition: none;
    }
  }
</style>
