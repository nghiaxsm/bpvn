

---
import Button from "../common/Button.astro";
import { productCategories } from "../../data/product-categories";

const solutions = [
  { id: "antibody", name: "Antibody" },
  { id: "peptide", name: "Peptide" },
  { id: "mrna", name: "mRNA" },
  { id: "viral-vector", name: "Viral Vector" },
  { id: "oligonucleotide", name: "Oligonucleotide" },
  { id: "recombinant-protein", name: "Recombinant Protein" },
];

const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname === path || pathname.startsWith(`${path}/`);
};
---

<header class="site-header">
  <div class="container header__inner">

    <!-- Logo -->
    <a
      href="/"
      class="header__brand"
      aria-label="Bioprocess Vietnam - Home"
    >
      <img
        src="/logos/logo.svg"
        alt="Bioprocess Vietnam"
        width="180"
        height="60"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Main navigation">

      <a
        href="/"
        class:list={["header__link", isActive("/") && "is-active"]}
        aria-current={isActive("/") ? "page" : undefined}
      >
        Home
      </a>

      <div class="header__nav-item header__nav-item--products">
        <a
          href="/products"
          class:list={["header__link", isActive("/products") && "is-active"]}
          aria-current={isActive("/products") ? "page" : undefined}
          aria-haspopup="true"
        >
          Products
        </a>

        <div class="products-dropdown" aria-label="Product categories">
          {productCategories.map((category) => (
            <a
              class="products-dropdown__link"
              href={`/products/?category=${category.id}`}
            >
              {category.name}
            </a>
          ))}
        </div>
      </div>

      <a
        href="/brands"
        class:list={["header__link", isActive("/brands") && "is-active"]}
        aria-current={isActive("/brands") ? "page" : undefined}
      >
        Brands
      </a>

      <div class="header__nav-item header__nav-item--solutions">
        <a
          href="/solutions"
          class:list={["header__link", isActive("/solutions") && "is-active"]}
          aria-current={isActive("/solutions") ? "page" : undefined}
          aria-haspopup="true"
        >
          Solutions
        </a>

        <div class="solutions-dropdown" aria-label="Solutions navigation">
          {solutions.map((solution) => (
            <a
              class="solutions-dropdown__link"
              href={`/solutions/${solution.id}/`}
            >
              {solution.name}
            </a>
          ))}
        </div>
      </div>

      <a
        href="/news"
        class:list={["header__link", isActive("/news") && "is-active"]}
        aria-current={isActive("/news") ? "page" : undefined}
      >
        News
      </a>

      <a
        href="/about"
        class:list={["header__link", isActive("/about") && "is-active"]}
        aria-current={isActive("/about") ? "page" : undefined}
      >
        About
      </a>

    </nav>

    <!-- Desktop CTA -->
    <div class="header__actions">
      <Button href="/contact" variant="primary" size="md">
        Contact Us
      </Button>
    </div>

    <!-- Mobile Navigation -->
    <details class="mobile-menu">
      <summary class="mobile-menu__toggle">
        <span>Menu</span>

        <span class="mobile-menu__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>

      <div class="mobile-menu__panel">

        <nav aria-label="Mobile navigation">

          <a
            href="/"
            class:list={["mobile-menu__link", isActive("/") && "is-active"]}
            aria-current={isActive("/") ? "page" : undefined}
          >
            Home
          </a>

          <a
            href="/products"
            class:list={["mobile-menu__link", isActive("/products") && "is-active"]}
            aria-current={isActive("/products") ? "page" : undefined}
          >
            Products
          </a>

          <a
            href="/brands"
            class:list={["mobile-menu__link", isActive("/brands") && "is-active"]}
            aria-current={isActive("/brands") ? "page" : undefined}
          >
            Brands
          </a>

          <a
            href="/solutions"
            class:list={["mobile-menu__link", isActive("/solutions") && "is-active"]}
            aria-current={isActive("/solutions") ? "page" : undefined}
          >
            Solutions
          </a>

          <a
            href="/news"
            class:list={["mobile-menu__link", isActive("/news") && "is-active"]}
            aria-current={isActive("/news") ? "page" : undefined}
          >
            News
          </a>

          <a
            href="/about"
            class:list={["mobile-menu__link", isActive("/about") && "is-active"]}
            aria-current={isActive("/about") ? "page" : undefined}
          >
            About
          </a>

        </nav>

        <Button href="/contact" variant="primary" fullWidth>
          Contact Us
        </Button>

      </div>
    </details>

  </div>
</header>

<style>
  @layer components {
  /* =====================================
     HEADER
  ===================================== */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    gap: var(--space-6);
  }

  /* Brand */

  .header__brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
  }

  .header__brand img {
    display: block;
    width: 180px;
    height: auto;
    max-height: 48px;
    object-fit: contain;
  }
/* Desktop Navigation */

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--header-height);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .header__link:hover,
  .header__link.is-active {
    color: var(--color-primary);
  }

  .header__link.is-active {
    font-weight: var(--font-weight-semibold);
  }

  .header__link.is-active::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: var(--color-primary);
    border-radius: var(--radius-full) var(--radius-full) 0 0;
    content: "";
  }

  .header__link:focus-visible,
  .mobile-menu__link:focus-visible,
  .mobile-menu__toggle:focus-visible {
    outline: 2px solid var(--color-primary-300);
    outline-offset: 4px;
  }


  /* Products and Solutions dropdowns */
  .header__nav-item--products,
  .header__nav-item--solutions {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--header-height);
  }

  .products-dropdown,
  .solutions-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 1100;
    display: none;
    gap: 0.25rem;
    width: max-content;
    min-width: 260px;
    max-width: min(420px, calc(100vw - 32px));
    padding: 0.5rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    box-shadow: var(--shadow-lg);
    transform: translateX(-50%);
  }

  .products-dropdown {
    flex-direction: column;
  }

  .solutions-dropdown {
    grid-template-columns: minmax(0, 1fr);
    width: max-content;
    min-width: 260px;
    max-width: min(320px, calc(100vw - 32px));
  }

  .header__nav-item--products:hover .products-dropdown,
  .header__nav-item--products:focus-within .products-dropdown {
    display: flex;
  }

  .header__nav-item--solutions:hover .solutions-dropdown,
  .header__nav-item--solutions:focus-within .solutions-dropdown {
    display: grid;
  }

  .products-dropdown__link,
  .solutions-dropdown__link {
    display: block;
    width: 100%;
    padding: 0.75rem 0.875rem;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    border-radius: var(--radius-md);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .products-dropdown__link:hover,
  .products-dropdown__link:focus-visible,
  .solutions-dropdown__link:hover,
  .solutions-dropdown__link:focus-visible {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .products-dropdown__link:focus-visible,
  .solutions-dropdown__link:focus-visible {
    outline: 2px solid var(--color-primary-300);
    outline-offset: 1px;
  }

  @media (max-width: 900px) {
    .products-dropdown,
    .solutions-dropdown {
      display: none !important;
    }
  }

  /* Legacy Products dropdown selectors retained below only where needed */
  .header__nav-item--products {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--header-height);
  }



  /* Desktop CTA */

  .header__actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  /* Mobile Menu */

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    background: var(--color-primary-soft);
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }

  .mobile-menu__icon span {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: var(--radius-full);
  }

  .mobile-menu__panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    z-index: var(--z-dropdown);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: min(320px, calc(100vw - 36px));
    padding: var(--space-4);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu__panel nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu__link {
    display: block;
    padding: 0.875rem 1rem;
    color: var(--color-text-secondary);
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-md);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .mobile-menu__link:hover,
  .mobile-menu__link.is-active {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .mobile-menu__link.is-active {
    font-weight: var(--font-weight-semibold);
  }

  /* Responsive */

  @media (max-width: 1024px) {
    .header__nav {
      gap: var(--space-4);
    }

    .header__brand img {
      width: 155px;
    }
  }

  @media (max-width: 900px) {
    .header__nav,
    .header__actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

  }

  @media (max-width: 560px) {
    .header__brand img {
      width: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__link,
    .mobile-menu__link {
      transition: none;
    }
  }
  }
</style>
