---
interface Props {
  variant?: "primary" | "outline" | "outline-light" | "filter";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  fullWidth?: boolean;
  target?: "_blank" | "_self";
  rel?: string;
  class?: string;
  ariaPressed?: boolean;
  dataFilterToggle?: string;
  dataFilterValue?: string;
  dataParentId?: string;
  dataFilterAll?: string;
  dataClearFilters?: boolean;
  dataHeroPrevious?: boolean;
  dataHeroNext?: boolean;
  dataHeroDot?: number;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  disabled = false,
  fullWidth = false,
  target,
  rel,
  class: className = "",
  ariaPressed,
  dataFilterToggle,
  dataFilterValue,
  dataParentId,
  dataFilterAll,
  dataClearFilters = false,
  dataHeroPrevious = false,
  dataHeroNext = false,
  dataHeroDot,
} = Astro.props;

const classes = [
  "button",
  `button--${variant}`,
  `button--${size}`,
  fullWidth && "button--full",
  className,
];
---

{href ? (
  <a
    class:list={classes}
    href={disabled ? undefined : href}
    target={target}
    rel={target === "_blank" ? (rel ?? "noopener noreferrer") : rel}
    aria-disabled={disabled ? "true" : undefined}
    tabindex={disabled ? -1 : undefined}
  >
    <slot name="icon-start" />
    <span class="button__label"><slot /></span>
    <slot name="icon-end" />
  </a>
) : (
  <button
    class:list={classes}
    type={type}
    disabled={disabled}
    aria-pressed={ariaPressed}
    data-filter-toggle={dataFilterToggle}
    data-filter-value={dataFilterValue}
    data-parent-id={dataParentId}
    data-filter-all={dataFilterAll}
    data-clear-filters={dataClearFilters ? "" : undefined}
    data-hero-previous={dataHeroPrevious ? "" : undefined}
    data-hero-next={dataHeroNext ? "" : undefined}
    data-hero-dot={dataHeroDot}
  >
    <slot name="icon-start" />
    <span class="button__label"><slot /></span>
    <slot name="icon-end" />
  </button>
)}

<style>
    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      border: 1px solid transparent;
      border-radius: 9999px;
      font-family: inherit;
      font-weight: var(--font-weight-semibold);
      line-height: 1.4;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
      transition:
        color var(--transition-fast),
        background-color var(--transition-fast),
        border-color var(--transition-fast),
        box-shadow var(--transition-fast);
    }

    .button__label {
      display: inline-block;
    }

    .button--sm {
      min-height: 36px;
      padding: 0.5rem 0.875rem;
      font-size: var(--text-small);
    }

    .button--md {
      min-height: 44px;
      padding: 0.625rem 1.25rem;
      font-size: var(--text-body);
    }

    .button--lg {
      min-height: 52px;
      padding: 0.875rem 1.75rem;
      font-size: var(--text-body-lg);
    }

    .button--primary {
      color: #FFFFFF;
      background: var(--color-primary);
      border-color: var(--color-primary);
    }

    .button--primary .button__label {
      color: #FFFFFF;
    }

    .button--primary:hover:not(:disabled):not([aria-disabled="true"]) {
      color: #FFFFFF;
      background: var(--color-primary-hover);
      border-color: var(--color-primary-hover);
    }

    .button--outline {
      color: var(--color-primary);
      background: transparent;
      border-color: var(--color-primary);
    }

    .button--outline .button__label {
      color: var(--color-primary);
    }

    .button--outline:hover:not(:disabled):not([aria-disabled="true"]) {
      color: #FFFFFF;
      background: var(--color-primary);
      border-color: var(--color-primary);
    }

    .button--outline:hover:not(:disabled):not([aria-disabled="true"]) .button__label {
      color: #FFFFFF;
    }

    .button--outline-light {
      color: #FFFFFF;
      background: transparent;
      border-color: #FFFFFF;
    }

    .button--outline-light .button__label {
      color: #FFFFFF;
    }

    .button--outline-light:hover:not(:disabled):not([aria-disabled="true"]) {
      color: var(--color-primary);
      background: #FFFFFF;
      border-color: #FFFFFF;
    }

    .button--outline-light:hover:not(:disabled):not([aria-disabled="true"]) .button__label {
      color: var(--color-primary);
    }

    /* Compact filter toggle variant */
    .button--filter {
      min-height: 30px;
      padding: 0.3rem 0.65rem;
      border-color: var(--color-border-strong);
      border-radius: 9999px;
      background: var(--color-white);
      color: var(--color-text-secondary);
      font-size: 0.75rem;
      font-weight: var(--font-weight-medium);
      line-height: 1.25;
    }

    .button--filter .button__label {
      color: inherit;
    }

    .button--filter:hover:not(:disabled) {
      border-color: var(--color-primary-400);
      background: var(--color-primary-50);
      color: var(--color-primary-700);
    }

    .button--filter[aria-pressed="true"] {
      border-color: var(--color-primary-700);
      background: var(--color-primary-700);
      color: #FFFFFF;
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 12%);
    }

    .button--filter[aria-pressed="true"] .button__label {
      color: #FFFFFF;
    }

    .button--filter-all {
      min-height: 26px;
      padding: 0.2rem 0.55rem;
      border-color: var(--color-primary-200);
      background: var(--color-primary-50);
      color: var(--color-primary-700);
      font-size: 0.6875rem;
    }

    .button--filter-all[aria-pressed="false"] {
      border-color: var(--color-border);
      background: var(--color-white);
      color: var(--color-text-muted);
    }

    .button:focus-visible {
      outline: 2px solid var(--color-primary-300);
      outline-offset: 3px;
    }

    .button:disabled,
    .button[aria-disabled="true"] {
      color: var(--color-disabled-text);
      background: var(--color-disabled);
      border-color: var(--color-disabled);
      cursor: not-allowed;
    }

    .button:disabled .button__label,
    .button[aria-disabled="true"] .button__label {
      color: var(--color-disabled-text);
    }

    .button--full {
      width: 100%;
    }

    @media (prefers-reduced-motion: reduce) {
      .button {
        transition: none;
      }
    }
</style>
