---
interface Props {
  padding?: "sm" | "md" | "lg";
  variant?: "default" | "outlined" | "elevated";
  hover?: boolean;
  href?: string;
  class?: string;
}

const {
  padding = "md",
  variant = "default",
  hover = false,
  href,
  class: className = "",
} = Astro.props;

const classes = [
  "card",
  `card--${padding}`,
  `card--${variant}`,
  hover && "card--hover",
  className,
];
---

{href ? (
  <a
    class:list={classes}
    href={href}
  >
    <slot />
  </a>
) : (
  <article class:list={classes}>
    <slot />
  </article>
)}

<style>
  @layer components {
    /* =====================================
       CARD
    ===================================== */

    .card {
      display: block;
      min-width: 0;
      color: var(--color-text);
      background: var(--color-white);
      border: 1px solid transparent;
      border-radius: var(--radius-lg, 0.75rem);
      text-decoration: none;
    }

    /* Padding */

    .card--sm {
      padding: var(--space-4);
    }

    .card--md {
      padding: var(--space-6);
    }

    .card--lg {
      padding: var(--space-8);
    }

    /* Variants */

    .card--default {
      border-color: transparent;
    }

    .card--outlined {
      border-color: var(--color-border);
    }

    .card--elevated {
      border-color: var(--color-border);
      box-shadow: var(--shadow-sm, 0 1px 3px rgb(33 27 50 / 8%));
    }

    /* Hover interaction */

    .card--hover {
      position: relative;
      z-index: 0;
      transition:
        transform var(--transition-fast),
        box-shadow var(--transition-fast),
        border-color var(--transition-fast);
    }

    .card--hover:hover {
      z-index: 1;
      color: var(--color-text);
      transform: translateY(-3px);
      box-shadow: var(--shadow-md, 0 6px 18px rgb(33 27 50 / 12%));
    }

    .card--outlined.card--hover:hover {
      border-color: var(--color-primary-300);
    }

    /* Keyboard focus */

    .card:focus-visible {
      outline: 2px solid var(--color-primary-300);
      outline-offset: 3px;
    }

    /* Reduced motion */

    @media (prefers-reduced-motion: reduce) {
      .card--hover {
        transition: none;
      }

      .card--hover:hover {
        transform: none;
      }
    }
  }
</style>
